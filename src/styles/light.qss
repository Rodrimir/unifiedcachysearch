QMainWindow, QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
}
#titleBar {
    background-color: #e6e9ef;
    border-bottom: 1px solid #bcc0cc;
}
#titleLabel {
    color: #4c4f69;
    font-size: 13px;
    font-weight: bold;
}
#titleButton {
    background-color: transparent;
    border: none;
    color: #4c4f69;
    font-size: 16px;
    border-radius: 6px;
    padding: 2px;
}
#titleButton:hover {
    background-color: #ccd0da;
}
#closeButton {
    background-color: transparent;
    border: none;
    color: #4c4f69;
    font-size: 16px;
    border-radius: 6px;
    padding: 2px;
}
#closeButton:hover {
    background-color: #d20f39;
    color: #eff1f5;
}
#searchWidget {
    background-color: #eff1f5;
    border-bottom: 1px solid #bcc0cc;
}
QLineEdit {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 2px solid #bcc0cc;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 14px;
}
QLineEdit:focus {
    border-color: #1e66f5;
}
QPushButton {
    background-color: #ccd0da;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton:hover {
    border-color: #1e66f5;
}
QPushButton:pressed {
    background-color: #e6e9ef;
}
#searchButton {
    background-color: #1e66f5;
    color: #e6e9ef;
    border: none;
}
#searchButton:hover {
    background-color: #6c9af7;
}
#installAllButton {
    background-color: #40a02b;
    color: #eff1f5;
    border: none;
}
#installAllButton:hover {
    background-color: #5cb85c;
}
#exportButton {
    background-color: #df8e1d;
    color: #eff1f5;
    border: none;
}
#exportButton:hover {
    background-color: #e8a540;
}
#updateButton {
    background-color: #fe640b;
    color: #eff1f5;
    border: none;
}
#updateButton:hover {
    background-color: #fe7c33;
}
#filterButton {
    background-color: transparent;
    border: 1px solid #bcc0cc;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: normal;
}
#filterButton:checked {
    background-color: #1e66f5;
    color: #e6e9ef;
    border-color: #1e66f5;
}
#filterButton:hover {
    border-color: #1e66f5;
}
#countLabel {
    color: #6c6f85;
    font-size: 12px;
}
QListView {
    background-color: #eff1f5;
    border: none;
    outline: none;
}
#statusWidget {
    background-color: #e6e9ef;
    border-top: 1px solid #bcc0cc;
}
#statusLabel {
    color: #6c6f85;
    font-size: 12px;
}
QProgressBar {
    background-color: #bcc0cc;
    border: none;
    border-radius: 3px;
}
QProgressBar::chunk {
    background-color: #1e66f5;
    border-radius: 3px;
}
QSplitter::handle {
    background-color: #bcc0cc;
    width: 1px;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #bcc0cc;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #ccd0da;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QCompleter {
    background-color: #eff1f5;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 4px;
}
QCompleter::item:selected {
    background-color: #1e66f5;
    color: #e6e9ef;
}
