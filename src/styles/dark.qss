QMainWindow, QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
#titleBar {
    background-color: #181825;
    border-bottom: 1px solid #45475a;
}
#titleLabel {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: bold;
}
#titleButton {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 16px;
    border-radius: 6px;
    padding: 2px;
}
#titleButton:hover {
    background-color: #313244;
}
#closeButton {
    background-color: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 16px;
    border-radius: 6px;
    padding: 2px;
}
#closeButton:hover {
    background-color: #f38ba8;
    color: #1e1e2e;
}
#searchWidget {
    background-color: #1e1e2e;
    border-bottom: 1px solid #45475a;
}
QLineEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 14px;
}
QLineEdit:focus {
    border-color: #89b4fa;
}
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton:hover {
    border-color: #89b4fa;
}
QPushButton:pressed {
    background-color: #181825;
}
#searchButton {
    background-color: #89b4fa;
    color: #181825;
    border: none;
}
#searchButton:hover {
    background-color: #b4d0fb;
}
#installAllButton {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
}
#installAllButton:hover {
    background-color: #b8ebc0;
}
#exportButton {
    background-color: #f9e2af;
    color: #1e1e2e;
    border: none;
}
#exportButton:hover {
    background-color: #fcefb8;
}
#updateButton {
    background-color: #fab387;
    color: #1e1e2e;
    border: none;
}
#updateButton:hover {
    background-color: #fbc89e;
}
#filterButton {
    background-color: transparent;
    border: 1px solid #45475a;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: normal;
}
#filterButton:checked {
    background-color: #89b4fa;
    color: #181825;
    border-color: #89b4fa;
}
#filterButton:hover {
    border-color: #89b4fa;
}
#countLabel {
    color: #a6adc8;
    font-size: 12px;
}
QListView {
    background-color: #1e1e2e;
    border: none;
    outline: none;
}
#statusWidget {
    background-color: #181825;
    border-top: 1px solid #45475a;
}
#statusLabel {
    color: #a6adc8;
    font-size: 12px;
}
QProgressBar {
    background-color: #45475a;
    border: none;
    border-radius: 3px;
}
QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 3px;
}
QSplitter::handle {
    background-color: #45475a;
    width: 1px;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #313244;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QCompleter {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
}
QCompleter::item:selected {
    background-color: #89b4fa;
    color: #181825;
}
